# Project defaults for the JC3248W535 (ESP32-S3, 16 MB QIO flash, 8 MB octal PSRAM).
# PlatformIO generates sdkconfig.<env> from this file on the first build.
# Delete that generated file after editing this one so the changes are picked up.

# Flash: 16 MB with the OTA-ready layout in partitions.csv
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: the LVGL frame buffer lives here
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# CPU / RTOS
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Speed optimisation: full-screen redraws (full_refresh + software rotation) need it
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# --- TouchDuino ---
# Tape pulse ISR keeps running even while flash cache is disabled (NVS writes)
CONFIG_GPTIMER_ISR_IRAM_SAFE=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
# Long file names on the SD card
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
# Bigger main task stack for UI bring-up
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Large allocations (cover art, LVGL objects) may come from PSRAM
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# USB file transfer mode: the SD card as a USB drive (TinyUSB MSC on the native USB port)
CONFIG_TINYUSB_MSC_ENABLED=y
# 512 = the Espressif default. 8192 hung the USB IN interrupt on the first
# disk read (interrupt watchdog in proc_read10_cmd -> usbd_edpt_xfer)
CONFIG_TINYUSB_MSC_BUFSIZE=512
CONFIG_TINYUSB_TASK_AFFINITY_CPU0=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="TouchDuino"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="TouchDuino SD card"
CONFIG_TINYUSB_DESC_MSC_STRING="TouchDuino SD card"
# No TinyUSB debug prints: they run inside the USB ISR and, with the COM port
# gone in USB mode, stall it into the interrupt watchdog
CONFIG_TINYUSB_DEBUG_LEVEL=0
